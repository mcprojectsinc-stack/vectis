# Vectis - server environment template.
# Copy to .env for local use, or set these in your host's Node app UI in production.
# Never commit a real .env (it is git-ignored).

# ---- Core ----
PORT=4000
# CHANGE THIS in production - signs all auth tokens.
JWT_SECRET=dev-secret-change-me
# Master key for encrypting provider secrets at rest (AI keys, Slack URL, SMTP pass, Jira token).
# If unset, a key is derived from JWT_SECRET. Set a strong, STABLE value in production -
# changing it makes previously stored secrets undecryptable (re-enter them in Integrations).
VECTIS_ENC_KEY=
# SQLite database file. Keep this on a persistent path.
DB_PATH=./data/td.sqlite

# ---- Deployment shape ----
# Mount the whole app under a subpath (e.g. /vectis). Leave empty for a domain/subdomain root.
BASE_PATH=
# Directory of the built UI to serve (the production bundle ships this as ./public).
WEB_DIST=./public

# ---- Autopilot ----
AUTOPILOT_TICK_MS=4000
JIRA_SYNC_MS=60000
METRIC_RETENTION_HOURS=24

# ---- Seeded demo account ----
# Set these to empty strings to disable the demo login in production.
DEMO_ORG=Demo Org
DEMO_EMAIL=demo@local
DEMO_PASSWORD=demo1234
DEMO_ENROLL_TOKEN=dev-enroll-token
